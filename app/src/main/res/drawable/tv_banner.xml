    android:height="112dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
  <!-- Same flat background tone as ic_launcher_background.xml, filling the whole banner. -->
  <path
      android:pathData="M0,0h320v180h-320z"
      android:fillColor="#f5f5f5"/>
  <!-- The ic_launcher_foreground.xml "Z" bolt glyph, scaled down and recentred from its
       original 512x512 viewport into this banner's 320x180 one: scaling around the glyph's
       own centroid (258,257.5) leaves that point fixed, so the subsequent translate alone
       repositions it to the banner's centre (160,90) without needing to hand-recompute every
       path coordinate. -->
